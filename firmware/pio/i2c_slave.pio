;
; I2C slave — one handshake per byte.
;
; The state machine is the bit engine: it shifts bytes in and out, and holds
; the bus still while the CPU decides what each one means. After every byte it
; pulls SCL low, raises an IRQ and blocks until the CPU answers.
;
; That stretch is the load-bearing trick of the whole product. Without it the
; ACK decision has to fit inside one SCL period — about 1 us at Fast-mode Plus
; — which is not enough for an address lookup plus anything else. Stretching
; turns a hard real-time deadline into a soft one, and real I2C slaves stretch
; under load, so the bus sees nothing unusual.
;
; Because the CPU is asked once per byte, nearly all the behaviour lives
; there: which addresses answer, whether a write is taken, which register a
; read returns. The program only has to keep time.
;
; ---------------------------------------------------------------------------
; Open drain
; ---------------------------------------------------------------------------
; A line is never driven high. The external pull-up does that, and a device
; only ever pulls low. So the output registers are loaded with 0 once at init
; and the program manipulates PIN DIRECTIONS:
;
;   pindir 1   pin becomes an output driving the stored 0  -> line LOW
;   pindir 0   pin becomes an input                        -> line HIGH
;
; Driving a value instead of a direction is how you get two devices fighting
; over a line, and it does not always show up until a second device is added.
;
; ---------------------------------------------------------------------------
; Pin mapping — one pin per mechanism
; ---------------------------------------------------------------------------
; IN, SET and OUT share a base:
;
;   base + 0   SDA
;   base + 1   SCL
;
;   SET / OUT   write SDA only (count = 1): the ACK, and the data bits.
;   side-set    writes SCL only: "side 1" holds it low, "side 0" releases it.
;   IN          samples SDA, masked to one pin so that MOV X, PINS reads SDA
;               alone — that is what the reframe watch compares.
;   JMP PIN     is SCL: "is the clock still high?"
;
; Splitting them this way means the stretch costs no instruction of its own:
; side-set rides along with whatever instruction is already executing. It also
; means SDA and SCL can never be written by the same instruction, so an ACK
; can never accidentally release the clock.
;
; A .pio file cannot choose the pin counts, the side-set pin or the JMP pin.
; They are set in C, in i2c_slave_program_init() below.
;
; ---------------------------------------------------------------------------
; One byte, step by step
; ---------------------------------------------------------------------------
;   1. Idle watches for a START: SDA falling while SCL is high.
;   2. Eight bits are shifted in and autopushed to the RX FIFO.
;   3. On the falling edge of the eighth clock, side-set pulls SCL low. The
;      master is now held; it cannot start the ninth clock.
;   4. IRQ 0 (relative to this state machine) wakes the CPU. IRQ 4 is set or
;      clear beside it, saying whether that byte is data or an address.
;   5. PULL blocks. The state machine does nothing at all until the CPU
;      answers, however long that takes.
;   6. The answer carries the ACK bit, where to continue — idle, rx_path or
;      tx_path — and, for a read, the byte to send.
;
; ---------------------------------------------------------------------------
; What this version does NOT do
; ---------------------------------------------------------------------------
; * One byte per read. A master that keeps clocking reads 0xFF after the
;   first byte, because the program drops back to idle instead of asking for
;   another. Burst reads need the master's ACK sampled on the ninth clock,
;   and THE BLOCK IS FULL: 32 of 32 instructions. Adding that means taking
;   something out, or splitting the read and write paths across two state
;   machines sharing this program.
; * Nothing enforces what a write means. The CPU takes or NACKs each byte.
; * A master that walks away mid-read leaves SDA held low until the next
;   transaction reframes the program.
;

.program i2c_slave
.side_set 1 opt pindirs         ; side-set is SCL's direction: 1 = hold low

; Pin offsets from the IN/SET/OUT base.
.define PIN_SDA 0
.define PIN_SCL 1

; SET/OUT write SDA only, so the patterns are one bit wide.
.define RELEASE_SDA 0
.define DRIVE_SDA   1

; How long SDA is given to settle before SCL is released, in state-machine
; cycles. The machine runs at 64 cycles per SCL period, so this is about an
; eighth of a bit time — far more than the 100 ns the spec asks for.
.define ACK_SETUP 7

; IRQ flag 4 (relative to this state machine, so 4..7) marks the byte in the
; RX FIFO as DATA rather than an address. Flags 4-7 cannot reach the CPU as an
; interrupt, which is exactly right: this is a label on the byte, read by the
; handler that flag 0 already woke.
.define MARK_DATA 4

; --- address phase -----------------------------------------------------
; Eight bits, MSB first, each sampled while SCL is high. Both edges must be
; waited on: WAIT 1 returns immediately if the line is already high, so
; without the falling-edge wait the loop would read the same bit eight times.
;
; Entered from three places: a START from idle, a repeated START spotted
; mid-transaction, and a STOP — after a STOP the next falling edge of SCL can
; only belong to the next transaction's first bit, so waiting for it is the
; same as waiting for the START.
got_start:
    irq clear MARK_DATA rel     ; a new address: whatever came before is over
    set x, 7
addr_bit:
    wait 0 pin PIN_SCL
    wait 1 pin PIN_SCL
    in pins, 1                      ; autopush delivers the byte after 8 bits
    jmp x-- addr_bit

; --- stretch, and ask the CPU ------------------------------------------
; Shared by the address byte and every data byte the master writes. The CPU
; answers all three questions at once, in one word:
;
;   bit 31      ACK: 1 drives SDA low, 0 leaves it high
;   bits 30:26  where to go next: idle, rx_path or tx_path
;   bits 25:18  the byte to send, already inverted (tx_path only)
;
; A NACK is just an answer whose ACK bit is 0 and whose continuation is idle,
; so it needs no branch of its own.
;
; The stretch starts on the falling edge of the eighth clock, not earlier:
; pulling SCL low while the master still holds it high would cut its high
; period short.
handshake:
    wait 0 pin PIN_SCL
    irq nowait 0 rel         side 1 ; hold SCL low; byte is in the RX FIFO
    pull block                      ; the answer — blocks for as long as it takes
    out pindirs, 1 [ACK_SETUP]      ; ACK or NACK, then let SDA settle
    wait 1 pin PIN_SCL       side 0 ; release SCL; the master takes its ninth clock
    wait 0 pin PIN_SCL
    set pindirs, RELEASE_SDA        ; release SDA once the clock has fallen
    out pc, 5                       ; go where the CPU said

; --- receiving, master writing -----------------------------------------
; The first bit of a byte is the only place a START or STOP can appear, so it
; is the only bit that needs watching. Sample SDA when SCL rises, then watch
; it until SCL falls:
;
;   SDA steady           an ordinary data bit
;   SDA fell   while high  repeated START — an address follows
;   SDA rose   while high  STOP — the transaction is over
;
; Both of those mean the next byte is an address, and got_start handles
; either. Nothing is shifted into the ISR until the bit is known to be real,
; so a reframe never leaves half a byte behind.
public rx_path:
    wait 1 pin PIN_SCL
    mov y, pins                     ; SDA at the rising edge (IN count masks it to one bit)
rx_watch:
    mov x, pins
    jmp x!=y, got_start             ; SDA moved while SCL was high: START or STOP
    jmp pin rx_watch                ; SCL still high: keep watching
    in y, 1                         ; SCL fell with SDA steady: a real bit
    set x, 6                        ; seven more, then the same handshake
    irq nowait MARK_DATA rel        ; label the byte: data, not an address
    jmp addr_bit

; --- transmitting, master reading --------------------------------------
; One byte out, MSB first, taken from the answer word the handshake already
; pulled. OUT writes straight to PINDIRS, where 1 means "pull low", so the CPU
; supplies the byte inverted — that keeps an instruction out of a loop that
; runs eight times per byte.
;
; Each bit is placed while SCL is low and held across the high period. After
; the eighth bit the program falls into idle, which releases SDA in time for
; the master's own ACK.
public tx_path:
    set y, 7
tx_bit:
    out pindirs, 1
    wait 1 pin PIN_SCL
    wait 0 pin PIN_SCL
    jmp y-- tx_bit

; --- idle ---------------------------------------------------------------
; Also the answer to a NACK, and where the transmit path ends up. Releasing
; both lines here means no failure leaves the bus held down.
public idle:
    set pindirs, RELEASE_SDA side 0
.wrap_target
wait_start:
    wait 1 pin PIN_SDA
    wait 0 pin PIN_SDA              ; SDA falls...
    jmp pin got_start               ; ...and SCL is still high: START
.wrap

% c-sdk {
#include "hardware/clocks.h"
#include "hardware/gpio.h"

/* Configure a state machine as an I2C slave on two consecutive pins.
 *
 *   pin_sda    the lower of the pair; SCL must be pin_sda + 1
 *   bus_hz     the bus speed the master will drive, e.g. 400000
 *
 * The state machine is left STOPPED. Start it only once something is ready to
 * answer the handshake IRQ — a state machine that stretches with nobody
 * listening holds the bus down for good.
 *
 * The clock divider sets how finely the program can resolve an edge, not the
 * bus speed — the master owns the clock. Running the state machine much
 * faster than the bus keeps the sampling point well inside the data window,
 * and gives the reframe watch many looks at SDA per clock.
 */
static inline void i2c_slave_program_init(PIO pio, uint sm, uint offset, uint pin_sda,
                                          uint bus_hz) {
    const uint pin_scl = pin_sda + 1;

    pio_sm_config c = i2c_slave_program_get_default_config(offset);

    // SET and OUT reach SDA only. SCL is side-set's, and nothing else writes
    // it, so releasing the clock is always deliberate.
    sm_config_set_in_pins(&c, pin_sda);
    sm_config_set_set_pins(&c, pin_sda, 1);
    sm_config_set_out_pins(&c, pin_sda, 1);
    sm_config_set_sideset_pins(&c, pin_scl);
    sm_config_set_jmp_pin(&c, pin_scl);

    // One input pin, so MOV X, PINS reads SDA and nothing else. Without this
    // the reframe watch would compare every GPIO on the chip, and a PWM
    // output elsewhere on the board would look like a STOP.
    sm_config_set_in_pin_count(&c, 1);

    // IN: MSB first, autopush at 8, so a byte arrives on its own.
    // OUT: no autopull. The answer word is pulled once and then read in
    // pieces — ACK bit, continuation, byte — and autopull would refill it
    // part-way through.
    sm_config_set_in_shift(&c, false, true, 8);    // shift left, autopush at 8
    sm_config_set_out_shift(&c, false, false, 32); // shift left, no autopull

    // Oversample the bus heavily. At 400 kHz this is 32 state-machine cycles
    // per SCL half-period, which is ample for WAIT to catch an edge.
    float div = (float)clock_get_hz(clk_sys) / (float)(bus_hz * 64);
    if (div < 1.0f) {
        div = 1.0f;
    }
    sm_config_set_clkdiv(&c, div);

    pio_gpio_init(pio, pin_sda);
    pio_gpio_init(pio, pin_scl);

    // THE open-drain setup: the output registers hold 0 permanently, so
    // making a pin an output can only ever pull it low. Start with both as
    // inputs so the bus is released until the program drives it.
    pio_sm_set_pins_with_mask(pio, sm, 0, (1u << pin_sda) | (1u << pin_scl));
    pio_sm_set_pindirs_with_mask(pio, sm, 0, (1u << pin_sda) | (1u << pin_scl));

    // Internal pull-ups are far too weak for I2C edges. Leaving them off
    // means a missing external resistor fails loudly instead of limping.
    gpio_disable_pulls(pin_sda);
    gpio_disable_pulls(pin_scl);

    // Start at idle, not at the first instruction. The program is laid out
    // with the bit loops first, and entering there would mean starting in the
    // middle of a transaction that never began.
    pio_sm_init(pio, sm, offset + i2c_slave_offset_idle, &c);
}

/* IRQ flag 4 + sm, set by the receive path and read by the handler: it says
 * the byte waiting in the RX FIFO is data, not an address. Flags 4-7 cannot
 * raise a system interrupt, which is what makes them safe to use as a label
 * on a byte rather than an event of their own. */
#define I2C_SLAVE_MARK_DATA 4u

/* The answer to one handshake, in one word.
 *
 *   bit 31      ACK. 1 drives SDA low; 0 leaves it high, which is a NACK.
 *   bits 30:26  where to continue: the program's idle, rx_path or tx_path,
 *               each plus the offset the program was loaded at.
 *   bits 25:18  the byte to send, inverted, because OUT writes PINDIRS where
 *               1 means "pull low". Only tx_path reads it.
 *
 * A NACK is an answer like any other: ACK bit clear, continuation idle.
 */
static inline uint32_t i2c_slave_answer(bool ack, uint continue_at, uint8_t tx_byte) {
    return ((uint32_t)(ack ? 1u : 0u) << 31) | ((uint32_t)(continue_at & 0x1fu) << 26) |
           ((uint32_t)(uint8_t)~tx_byte << 18);
}
%}
