;
; I2C slave — clock-stretch ACK handshake.
;
; The state machine shifts in the address byte, pulls SCL low to stretch the
; clock, raises an IRQ and blocks. The CPU decides ACK or NACK and pushes the
; answer back. Only then does the program release SCL and let the master take
; its ninth clock.
;
; This is the load-bearing trick of the whole product. Without it the ACK
; decision has to fit inside one SCL period — about 1 us at Fast-mode Plus —
; which is not enough for an address lookup plus anything else. Stretching
; turns a hard real-time deadline into a soft one, and real I2C slaves stretch
; under load, so the bus sees nothing unusual.
;
; ---------------------------------------------------------------------------
; Open drain
; ---------------------------------------------------------------------------
; A line is never driven high. The external pull-up does that, and a device
; only ever pulls low. So the output registers are loaded with 0 once at init
; and the program manipulates PIN DIRECTIONS:
;
;   pindir 1   pin becomes an output driving the stored 0  -> line LOW
;   pindir 0   pin becomes an input                        -> line HIGH
;
; Driving a value instead of a direction is how you get two devices fighting
; over a line, and it does not always show up until a second device is added.
;
; ---------------------------------------------------------------------------
; Pin mapping — one pin per mechanism
; ---------------------------------------------------------------------------
; IN, SET and OUT share a base:
;
;   base + 0   SDA
;   base + 1   SCL
;
;   SET / OUT   write SDA only (count = 1): ACK, and the data bits.
;   side-set    writes SCL only: "side 1" holds it low, "side 0" releases it.
;   IN          samples SDA.
;   JMP PIN     is SCL, for the START check.
;
; Splitting them this way means the stretch costs no instruction of its own:
; side-set rides along with whatever instruction is already executing. It also
; means SDA and SCL can never be written by the same instruction, so an ACK
; can never accidentally release the clock.
;
; A .pio file cannot choose the SET/OUT counts, the side-set pin or the JMP
; pin. They are set in C, in i2c_slave_program_init() below.
;
; ---------------------------------------------------------------------------
; The handshake, step by step
; ---------------------------------------------------------------------------
;   1. Eight address bits are shifted in and autopushed to the RX FIFO.
;   2. On the falling edge of the eighth clock, side-set pulls SCL low. The
;      master is now held. It cannot start the ninth clock.
;   3. IRQ 0 (relative to this state machine) tells the CPU an address is
;      waiting.
;   4. PULL blocks. The state machine does nothing at all until the CPU
;      answers, however long that takes.
;   5. The answer's top bit: 1 = ACK, 0 = NACK.
;        NACK -> jump to idle, which releases both lines. The master's ninth
;                clock then reads SDA high, which is a NACK.
;        ACK  -> drive SDA low, settle, then release SCL. The master's ninth
;                clock reads SDA low.
;   6. On ACK, a second word from the FIFO is the byte to send.
;
; ---------------------------------------------------------------------------
; What this version does NOT do
; ---------------------------------------------------------------------------
; * No write path. The address's R/W bit is passed to the CPU, but the program
;   always continues into the data phase, so the CPU must NACK writes until
;   task 16 adds the other branch.
; * No STOP or repeated-START detection during a transaction. Both are only
;   noticed by the idle loop, once the state machine gets back to it.
; * One byte per read. A master that keeps clocking reads 0xFF after the first
;   byte.
; * A master that walks away after the ACK leaves SDA held low, because the
;   first data bit is placed before the clock that would carry it. STOP
;   detection is what fixes that.
;
; None of these are oversights; they are the next tasks.
;

.program i2c_slave
.side_set 1 opt pindirs         ; side-set is SCL's direction: 1 = hold low

; Pin offsets from the IN/SET/OUT base.
.define PIN_SDA 0
.define PIN_SCL 1

; SET/OUT write SDA only, so the patterns are one bit wide.
.define RELEASE_SDA 0
.define DRIVE_SDA   1

; How long SDA is given to settle before SCL is released, in state-machine
; cycles. The machine runs at 64 cycles per SCL period, so this is about an
; eighth of a bit time — far more than the 100 ns the spec asks for.
.define ACK_SETUP 7

.wrap_target
idle:
    set pindirs, RELEASE_SDA side 0 ; release both lines: also the NACK answer
wait_start:
    wait 1 pin PIN_SDA
    wait 0 pin PIN_SDA              ; SDA falls...
    jmp pin got_start               ; ...and SCL is still high: START
    jmp wait_start                  ; SCL low: an ordinary data bit, keep looking
got_start:

; --- address phase -----------------------------------------------------
; Eight bits, MSB first, each sampled while SCL is high. Both edges must be
; waited on: WAIT 1 returns immediately if the line is already high, so
; without the falling-edge wait the loop would read the same bit eight times.
    set x, 7
addr_bit:
    wait 0 pin PIN_SCL
    wait 1 pin PIN_SCL
    in pins, 1                      ; autopush delivers the byte after 8 bits
    jmp x-- addr_bit

; --- stretch, and ask the CPU ------------------------------------------
; The stretch starts on the falling edge of the eighth clock, not earlier:
; pulling SCL low while the master still holds it high would cut its high
; period short.
    wait 0 pin PIN_SCL
    irq nowait 0 rel         side 1 ; hold SCL low; address is in the RX FIFO
    pull block                      ; the CPU's answer — blocks for as long as it takes
    out x, 1                        ; top bit: 1 = ACK, 0 = NACK
    jmp !x, idle                    ; NACK: idle releases SCL, master reads SDA high

; --- acknowledge -------------------------------------------------------
; SDA is driven low for the whole of the ninth clock: asserted before SCL is
; released, and released only after SCL falls again. That gives the master
; valid setup and hold either side of its sample.
    set pindirs, DRIVE_SDA [ACK_SETUP]
    wait 1 pin PIN_SCL       side 0 ; release SCL; the master takes its ninth clock
    wait 0 pin PIN_SCL
    set pindirs, RELEASE_SDA        ; release SDA before the data phase

; --- data phase, slave transmitting ------------------------------------
; One byte out, MSB first. OUT writes straight to PINDIRS, so the CPU must
; supply the byte ALREADY INVERTED: a 0 bit has to become pindirs=1 to pull
; the line low. Inverting on the CPU costs nothing and keeps an instruction
; out of a loop that runs eight times per byte.
;
; Each bit is placed while SCL is low and held across the high period.
    pull block                      ; the byte, pushed with the ACK
    set y, 7
data_bit:
    out pindirs, 1
    wait 1 pin PIN_SCL
    wait 0 pin PIN_SCL
    jmp y-- data_bit

; --- master's acknowledge ----------------------------------------------
; Release SDA so the master can answer. Its ACK or NACK is not inspected
; here; acting on a NACK needs STOP detection, which this version lacks.
    set pindirs, RELEASE_SDA
    wait 1 pin PIN_SCL
    wait 0 pin PIN_SCL
.wrap

% c-sdk {
#include "hardware/clocks.h"
#include "hardware/gpio.h"

/* Configure a state machine as an I2C slave on two consecutive pins.
 *
 *   pin_sda    the lower of the pair; SCL must be pin_sda + 1
 *   bus_hz     the bus speed the master will drive, e.g. 400000
 *
 * The state machine is left STOPPED. Start it only once something is ready to
 * answer the handshake IRQ — a state machine that stretches with nobody
 * listening holds the bus down for good.
 *
 * The clock divider sets how finely the program can resolve an edge, not the
 * bus speed — the master owns the clock. Running the state machine much
 * faster than the bus keeps the sampling point well inside the data window.
 */
static inline void i2c_slave_program_init(PIO pio, uint sm, uint offset, uint pin_sda,
                                          uint bus_hz) {
    const uint pin_scl = pin_sda + 1;

    pio_sm_config c = i2c_slave_program_get_default_config(offset);

    // SET and OUT reach SDA only. SCL is side-set's, and nothing else writes
    // it, so releasing the clock is always deliberate.
    sm_config_set_in_pins(&c, pin_sda);
    sm_config_set_set_pins(&c, pin_sda, 1);
    sm_config_set_out_pins(&c, pin_sda, 1);
    sm_config_set_sideset_pins(&c, pin_scl);
    sm_config_set_jmp_pin(&c, pin_scl);

    // IN: MSB first, autopush at 8, so the address byte arrives on its own.
    // OUT: no autopull. Each phase pulls its own word — a decision, then a
    // byte — and a PULL overwrites whatever the previous phase left behind.
    sm_config_set_in_shift(&c, false, true, 8);    // shift left, autopush at 8
    sm_config_set_out_shift(&c, false, false, 32); // shift left, no autopull

    // Oversample the bus heavily. At 400 kHz this is 32 state-machine cycles
    // per SCL half-period, which is ample for WAIT to catch an edge.
    float div = (float)clock_get_hz(clk_sys) / (float)(bus_hz * 64);
    if (div < 1.0f) {
        div = 1.0f;
    }
    sm_config_set_clkdiv(&c, div);

    pio_gpio_init(pio, pin_sda);
    pio_gpio_init(pio, pin_scl);

    // THE open-drain setup: the output registers hold 0 permanently, so
    // making a pin an output can only ever pull it low. Start with both as
    // inputs so the bus is released until the program drives it.
    pio_sm_set_pins_with_mask(pio, sm, 0, (1u << pin_sda) | (1u << pin_scl));
    pio_sm_set_pindirs_with_mask(pio, sm, 0, (1u << pin_sda) | (1u << pin_scl));

    // Internal pull-ups are far too weak for I2C edges. Leaving them off
    // means a missing external resistor fails loudly instead of limping.
    gpio_disable_pulls(pin_sda);
    gpio_disable_pulls(pin_scl);

    pio_sm_init(pio, sm, offset, &c);
}

/* The answer to the handshake. OUT X takes the top bit, so the flag lives in
 * bit 31. */
#define I2C_SLAVE_ACK  0x80000000u
#define I2C_SLAVE_NACK 0x00000000u

/* The data phase writes OSR bits straight to PINDIRS, where 1 means "pull
 * low". Invert here so the caller passes the byte it actually wants on the
 * wire.
 *
 * Non-blocking on purpose: this is called from the IRQ handler, where the FIFO
 * always has room, and blocking in an IRQ with the bus stretched would be the
 * worst possible place to wait. */
static inline void i2c_slave_prepare_byte(PIO pio, uint sm, uint8_t value) {
    pio_sm_put(pio, sm, (uint32_t)((uint8_t)~value) << 24);
}
%}
